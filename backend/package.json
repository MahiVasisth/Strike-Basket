{
  "name": "@strike-baskets/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --no-warnings=ExperimentalWarning src/main.ts",
    "start": "tsx --no-warnings=ExperimentalWarning src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "keygen": "tsx --no-warnings=ExperimentalWarning src/cli/keygen.ts",
    "probe": "tsx --no-warnings=ExperimentalWarning src/cli/probe.ts",
    "plan": "tsx --no-warnings=ExperimentalWarning src/cli/plan.ts",
    "connect-test": "tsx --no-warnings=ExperimentalWarning src/cli/connect-test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "decimal.js": "^10.6.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.10",
    "vitest": "^5.0.5"
  }
}
