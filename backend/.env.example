# ---------------------------------------------------------------------------
# Strike Baskets backend. Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# testnet | mainnet
STRIKE_ENV=testnet
# shadow = plan only, never sends orders | live = trades the vault
EXECUTION_MODE=shadow
# Mainnet is READ-ONLY unless this is set: every order/leverage/margin/TWAP/cancel request
# is refused inside the client. Leave it unset until the mainnet vault is funded.
# ALLOW_MAINNET_WRITES=yes

# API wallet (Ed25519). Generate with `pnpm keygen`. Trade-only: it cannot withdraw.
STRIKE_API_PUBLIC_KEY=
STRIKE_API_PRIVATE_KEY=
# Your user vault. Without it the engine runs a paper book.
STRIKE_VAULT_ID=
# Vault page link. Defaults to https://{app|testnet}.strikefinance.org/vaults/{vaultId}?ref=strikebaskets
# (keep a query string: Strike's CDN can serve a stale "Vault Not Found" for the bare URL)
# STRIKE_VAULT_URL_TEMPLATE=

# testnet: crypto-majors (BTC/ETH)   mainnet: preipo
BASKET_ID=crypto-majors
# Paper exchange (used when STRIKE_VAULT_ID is empty): starting equity and taker fee.
# Fills at bid/ask, charges the fee, accrues live funding.
SHADOW_EQUITY_USD=1000
PAPER_TAKER_FEE_BPS=5

# --- rebalancer ---
# Sum of |position notional| / equity. Max 1 (no leverage).
GROSS_EXPOSURE=0.9
# Rebalance when any weight is this far from target (500 = 5 percentage points).
# `pnpm probe` prints the smallest threshold your equity can actually trade.
DRIFT_THRESHOLD_BPS=500
MIN_NOTIONAL_BUFFER=1.2
MAX_LEG_NOTIONAL_USD=2000
MAX_RUN_NOTIONAL_USD=5000
REBALANCE_COOLDOWN_MIN=30

# --- execution ---
# Vaults default to isolated 10x. We set cross + low leverage per symbol before trading.
MARGIN_MODE=cross
SYMBOL_LEVERAGE=2
MAX_SLIPPAGE=0.01
# batch | twap  (twap only if `pnpm probe --twap` confirms /v2/algo/twap accepts vault_id)
EXECUTOR=batch
TWAP_MIN_NOTIONAL_USD=500
TWAP_DURATION_SEC=600
ORDER_CONFIRM_TIMEOUT_SEC=30

# --- market gates ---
# Testnet books are wide; use ~300 there. Mainnet basket books run ~6 bps.
MAX_SPREAD_BPS=50
MAX_MARK_MID_DEVIATION_BPS=100
MAX_BOOK_AGE_SEC=60
INDEX_FROZEN_MIN=30
BLOCK_ON_FROZEN_INDEX=false

# --- personal mode (Builder Connect; testnet only while mainnet is write-locked) ---
# Users connect their own Strike account; the engine rebalances the basket inside it and
# earns BUILDER_FEE_BPS per fill. Register the code at testnet.strikefinance.org/builder-codes.
PERSONAL_MODE=false
BUILDER_CODE=
BUILDER_FEE_BPS=10
# openssl rand -hex 32   (encrypts users' API-wallet keys at rest; keep it, or every user must reconnect)
PERSONAL_SECRET=
PERSONAL_MAX_USERS=50
PERSONAL_MAX_BUDGET_USD=5000

# --- service ---
CYCLE_SECONDS=300
PORT=8787
CORS_ORIGIN=*
# >= 16 chars. Enables POST /api/admin/* (pause, resume, rebalance, flatten).
ADMIN_TOKEN=
DB_PATH=data/baskets.db
LOG_LEVEL=info
